# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Non-Azure alternative — fill these instead of the Azure block above
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                    # optional, e.g. for local Ollama or proxy
# AZURE_OPENAI_MODEL=gpt-4o           # model name used for both Azure and direct OpenAI

# GitHub (fine-grained PAT for local dev; swapped for GitHub App installation auth later)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# App
DATABASE_URL=sqlite:///./pr_analyzer.db
CRITIC_CONFIDENCE_THRESHOLD=0.7
READER_CONCURRENCY=5
BLAST_RADIUS_MAX_DEPTH=3
BLAST_RADIUS_MAX_FILES=20
